{# _navbar.html.twig #}
<div class="md:flex md:flex-shrink-0">
    
    <div class="md:hidden fixed top-4 left-4 z-50">
        <button id="mobile-menu-button" class="text-white focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                 xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    
    <div id="sidebar"
         class="fixed inset-y-0 left-0 transform -translate-x-full md:translate-x-0 w-64 bg-indigo-700 text-white transition duration-200 ease-in-out z-40">
        <div class="flex flex-col h-full">
            <div class="flex items-center justify-center h-16 px-4 border-b border-indigo-600">
                <h1 class="text-2xl font-bold">eDziennik</h1>
            </div>
            <div class="flex flex-col flex-grow px-4 py-4 overflow-y-auto">
                <nav class="flex-1 space-y-2">
                    <a href="{{ path('homepage') }}"
                       class="flex items-center px-4 py-3 rounded-lg hover:bg-indigo-600 text-white">
                        <i class="fas fa-tachometer-alt mr-3"></i>
                        Strona Główna
                    </a>
                    {% if app.user.roles[0] == "ROLE_TEACHER" %}
                        <a href="{{ path('app_gradebook') }}"
                           class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                            <i class="fas fa-calendar-alt mr-3"></i>
                            Dziennik
                        </a>
                    {% else %}
                        <a href="{{ path('app_student_grades') }}"
                           class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                            <i class="fas fa-calendar-alt mr-3"></i>
                            Moje Oceny
                        </a>
                    {% endif %}
                    <a href="{{ path('app_schedule') }}"
                       class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                        <i class="fas fa-book mr-3"></i>
                        Plan Lekcji
                    </a>
                    {% if app.user.roles[0] == "ROLE_TEACHER" %}
                        <a href=" {{ path('app_homework') }}"
                           class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                            <i class="fas fa-tasks mr-3"></i>
                            Zadania
                        </a>
                    {% else %}
                        <a href="{{ path('app_homework_student') }}"
                           class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                            <i class="fas fa-calendar-alt mr-3"></i>
                            Zadania
                        </a>
                    {% endif %}
                    <a href="{{ path('app_profile') }}"
                       class="flex items-center px-4 py-3 rounded-lg text-indigo-200 hover:bg-indigo-600 hover:text-white">
                        <i class="fas fa-cog mr-3"></i>
                        Profil
                    </a>
                </nav>
            </div>
            <div class="p-4 border-t border-indigo-600">
                <div class="flex items-center">
                    <span class="text-xl bg-indigo-600 rounded-full text-gray-500">
                        {{ userData.firstName|first|upper }}{{ userData.lastName|first|upper }}
                    </span>
                    <div class="ml-3">
                        {% if userData is not null %}
                            <p class="text-sm font-medium">{{ userData.firstName }} {{ userData.lastName }}</p>
                            <p class="text-xs text-indigo-200">{{ app.user.roles[0]|translate_role }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-30"></div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        mobileMenuButton.addEventListener('click', function () {
            sidebar.classList.toggle('translate-x-0');
            sidebarOverlay.classList.toggle('hidden');
        });

        sidebarOverlay.addEventListener('click', function () {
            sidebar.classList.remove('translate-x-0');
            sidebarOverlay.classList.add('hidden');
        });
    });
</script>
