{% extends 'base.html.twig' %}

{% block title %}Profile Settings{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .border-red-500 {
            border-color: #ef4444 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100">
        {# Navbar #}
        {% include 'utils/_navbar.html.twig' %}

        <div class="md:ml-64 transition-all">
            <div class="container mx-auto px-4 py-8">
                <div class="max-w-3xl mx-auto">
                    <div class="bg-white rounded-lg shadow-md p-6 ">
                        {% include 'utils/_topheader.html.twig' %}
                        <div class="space-y-6">
                            {# Profile Picture Section #}
                            <div class="flex items-center space-x-4">
                                <div class="w-24 h-24 rounded-full bg-gray-200 flex items-center justify-center mt-5">
                                    <span class="text-3xl text-gray-500 space-y-4">
                                        {{ userData.firstName|first|upper }}{{ userData.lastName|first|upper }}
                                    </span>
                                </div>
                                <div>
                                    <h2 class="text-xl font-semibold text-gray-800">{{ userData.firstName }} {{ userData.lastName }}</h2>
                                    <p class="text-gray-600">{{ userData.email }}</p>
                                </div>
                            </div>

                            {# Personal Information #}
                            <div class="border-t pt-6">
                                <button class="collapsible">
                                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Informacje osobowe [+]</h3>
                                </button>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 content">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Imię</label>
                                        <p class="mt-1 text-gray-800">{{ userData.firstName }}</p>
                                    </div>
                                    {% if userData.secondName is not null %}
                                        <div>
                                            <label class="block text-sm font-medium text-gray-600">Drugie Imię</label>
                                            <p class="mt-1 text-gray-800">{{ userData.secondName }}</p>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Nazwisko</label>
                                        <p class="mt-1 text-gray-800">{{ userData.lastName }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Email</label>
                                        <p class="mt-1 text-gray-800">{{ userData.email }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Numer
                                            Telefonu</label>
                                        <p class="mt-1 text-gray-800"> {{ userData.phoneNumber }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Role</label>
                                        <p class="mt-1 text-gray-800">{{ userData.role[0]|translate_role }}</p>
                                    </div>
                                </div>
                            </div>
                            <div class="border-t pt-6">
                                <button class="collapsible">
                                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Adres Zamieszkania [+]</h3>
                                </button>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 content">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Kraj</label>
                                        <p class="mt-1 text-gray-800">{{ userData.country }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Województwo</label>
                                        <p class="mt-1 text-gray-800">{{ userData.voivodeship }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Miasto</label>
                                        <p class="mt-1 text-gray-800">{{ userData.city }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Kod Pocztowy</label>
                                        <p class="mt-1 text-gray-800"> {{ userData.postalCode }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Ulica</label>
                                        <p class="mt-1 text-gray-800">{{ userData.street }}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600">Numer Domu/Budynku</label>
                                        <p class="mt-1 text-gray-800">{{ userData.houseNumber }}</p>
                                    </div>
                                </div>
                            </div>


                            <button id="changePasswordBtn" class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                                Zmień hasło
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="changePasswordModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-lg shadow-xl w-full max-w-md">
                <div class="px-6 py-4 border-b">
                    <h3 class="text-lg font-semibold text-gray-900">Zmień hasło</h3>
                    <button id="closeModal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                
                {{ form_start(changePasswordForm, {'attr': {'id': 'changePasswordForm'}}) }}
                    <div class="px-6 py-4">
                        <div id="formErrors" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4"></div>
                        
                        <div class="space-y-4">
                            <div>
                                {{ form_label(changePasswordForm.currentPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(changePasswordForm.currentPassword) }}
                                <div id="currentPassword-error" class="text-red-600 text-sm mt-1 hidden"></div>
                            </div>
                            
                            <div>
                                {{ form_label(changePasswordForm.newPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(changePasswordForm.newPassword.first) }}
                                <div id="newPassword-error" class="text-red-600 text-sm mt-1 hidden"></div>
                            </div>
                            
                            <div>
                                {{ form_label(changePasswordForm.newPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(changePasswordForm.newPassword.second) }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="px-6 py-4 border-t bg-gray-50 flex justify-end space-x-3">
                        <button id="cancelBtn" type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                            Anuluj
                        </button>
                        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">
                            Zmień hasło
                        </button>
                    </div>
                {{ form_end(changePasswordForm) }}
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function() {
            $(".content").hide();
            $(".collapsible").click(function (){
               $(this).next(".content").slideToggle();
            });

            $('#changePasswordBtn').click(function() {
                $('#changePasswordModal').removeClass('hidden');
                clearErrors();
            });

            $('#closeModal, #cancelBtn').click(function() {
                $('#changePasswordModal').addClass('hidden');
                $('#changePasswordForm')[0].reset();
                clearErrors();
            });

            $('#changePasswordForm').submit(function(e) {
                e.preventDefault();
                clearErrors();
                
                $.ajax({
                    url: '{{ path('app_profile_change_password') }}',
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json',
                    success: function(response) {
                        if (response.success) {
                            $('#changePasswordModal').addClass('hidden');
                            $('#changePasswordForm')[0].reset();
                            
                            $('<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">' + 
                              response.message + '</div>')
                              .insertBefore('.bg-white.rounded-lg.shadow-md')
                              .delay(5000)
                              .fadeOut();
                        } else {
                            displayErrors(response.errors);
                        }
                    },
                    error: function() {
                        showFormError('Wystąpił błąd podczas zmiany hasła. Spróbuj ponownie.');
                    }
                });
            });

            function clearErrors() {
                $('#formErrors').addClass('hidden').empty();
                $('#currentPassword-error, #newPassword-error').addClass('hidden').empty();
                $('#changePasswordForm input').removeClass('border-red-500');
            }

            function displayErrors(errors) {
                for (let field in errors) {
                    if (errors[field] && errors[field].length > 0) {
                        $('#' + field + '-error').removeClass('hidden').html(errors[field].join('<br>'));
                        $('input[name*="[' + field + ']"]').addClass('border-red-500');
                    }
                }
            }

            function showFormError(message) {
                $('#formErrors').removeClass('hidden').html(message);
            }
        });
    </script>
{% endblock %}
