{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex h-screen overflow-hidden">
        {% include 'utils/_navbar.html.twig' %}

        <div class="flex flex-col flex-1 overflow-hidden md:pl-64">
            {% include 'utils/_topheader.html.twig' %}

            <main class="flex-1 overflow-y-auto p-6"
                  style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                
                <div class="mb-6">
                    <h1 class="text-2xl text-center font-bold text-gray-900">Moje Zadania Domowe</h1>
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    {% if message is defined %}
                        <div class="text-center py-8">
                            <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                                <p class="text-yellow-800">{{ message }}</p>
                            </div>
                        </div>
                    {% elseif homework is empty %}
                        <div class="text-center py-8">
                            <p class="text-gray-500 text-lg">Brak zadań domowych</p>
                            <p class="text-gray-400 text-sm">Nie masz przypisanych żadnych aktywnych zadań domowych</p>
                        </div>
                    {% else %}
                        <div class="grid gap-4">
                            {% for hw in homework %}
                                {% set today = date() %}
                                {% set dueDate = hw.dueDate %}
                                {% set isOverdue = dueDate < today %}
                                {% set isUrgent = (dueDate|date('U') - today|date('U')) / 86400 <= 3 and not isOverdue %}
                                
                                <div class="border rounded-lg p-4 
                                    {% if isOverdue %}
                                        border-red-200 bg-red-50
                                    {% elseif isUrgent %}
                                        border-yellow-200 bg-yellow-50
                                    {% else %}
                                        border-gray-200 hover:shadow-md
                                    {% endif %} 
                                    transition-shadow">
                                    
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <h3 class="font-semibold text-lg 
                                                    {% if isOverdue %}text-red-900
                                                    {% elseif isUrgent %}text-yellow-900
                                                    {% else %}text-gray-900{% endif %}">
                                                    {{ hw.topic }}
                                                </h3>
                                                
                                                {% if isOverdue %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                        Przeterminowane
                                                    </span>
                                                {% elseif isUrgent %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                        Pilne
                                                    </span>
                                                {% endif %}
                                            </div>
                                            
                                            <p class="text-sm 
                                                {% if isOverdue %}text-red-600
                                                {% elseif isUrgent %}text-yellow-600
                                                {% else %}text-gray-600{% endif %} mb-2">
                                                {{ hw.subject.value|trans({}, 'subjects') }} - {{ hw.teacher.person.firstName }} {{ hw.teacher.person.lastName }}
                                            </p>
                                            
                                            {% if hw.description %}
                                                <div class="bg-gray-100 rounded-md p-3 mt-3">
                                                    <h4 class="text-sm font-medium text-gray-700 mb-1">Opis zadania:</h4>
                                                    <p class="text-gray-700 text-sm">{{ hw.description }}</p>
                                                </div>
                                            {% endif %}
                                        </div>
                                        
                                        <div class="text-right ml-4">
                                            <div class="mb-2">
                                                <span class="text-sm font-medium 
                                                    {% if isOverdue %}text-red-600
                                                    {% elseif isUrgent %}text-yellow-600
                                                    {% else %}text-blue-600{% endif %}">
                                                    Termin: {{ hw.dueDate|date('d.m.Y') }}
                                                </span>
                                            </div>
                                            
                                            <div class="text-xs 
                                                {% if isOverdue %}text-red-500
                                                {% elseif isUrgent %}text-yellow-600
                                                {% else %}text-gray-500{% endif %}">
                                                {% set daysDiff = ((dueDate|date('U') - today|date('U')) / 86400)|round %}
                                                {% if isOverdue %}
                                                    Przeterminowane o {{ (daysDiff * -1) }} {% if (daysDiff * -1) == 1 %}dzień{% elseif (daysDiff * -1) < 5 %}dni{% else %}dni{% endif %}
                                                {% elseif daysDiff == 0 %}
                                                    Termin dzisiaj
                                                {% elseif daysDiff == 1 %}
                                                    Zostało: 1 dzień
                                                {% else %}
                                                    Zostało: {{ daysDiff }} {% if daysDiff < 5 %}dni{% else %}dni{% endif %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        
                        <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                            <h4 class="text-sm font-medium text-gray-700 mb-2">Legenda:</h4>
                            <div class="flex flex-wrap gap-4 text-xs">
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-red-200"></div>
                                    <span class="text-gray-600">Przeterminowane</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-yellow-200"></div>
                                    <span class="text-gray-600">Do 3 dni (pilne)</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-gray-200"></div>
                                    <span class="text-gray-600">Zwykłe</span>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
