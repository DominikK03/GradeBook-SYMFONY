{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex h-screen overflow-hidden">
        {% include 'utils/_navbar.html.twig' %}

        <div class="flex flex-col flex-1 overflow-hidden md:pl-64">
            {% include 'utils/_topheader.html.twig' %}

            <main class="flex-1 overflow-y-auto p-6"
                  style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold text-gray-900">Zadania Domowe</h1>
                    <button onclick="openHomeworkModal()" 
                            class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        Dodaj zadanie
                    </button>
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    {% if homework is empty %}
                        <div class="text-center py-8">
                            <p class="text-gray-500 text-lg">Brak aktywnych zadań domowych</p>
                            <p class="text-gray-400 text-sm">Dodaj pierwsze zadanie domowe klikając przycisk powyżej</p>
                        </div>
                    {% else %}
                        <div class="grid gap-4">
                            {% for hw in homework %}
                                <div class="border rounded-lg p-4 hover:shadow-md transition-shadow">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <h3 class="font-semibold text-lg text-gray-900">{{ hw.topic }}</h3>
                                            <p class="text-sm text-gray-600 mt-1">{{ hw.group.name.value }} - {{ hw.subject.value|trans({}, 'subjects') }}</p>
                                            {% if hw.description %}
                                                <p class="text-gray-700 mt-2">{{ hw.description }}</p>
                                            {% endif %}
                                        </div>
                                        <div class="text-right">
                                            <span class="text-sm font-medium text-blue-600">
                                                Termin: {{ hw.dueDate|date('d.m.Y') }}
                                            </span>
                                            <div class="mt-1">
                                                <span id="status-{{ hw.id }}" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                    {% if hw.status.value == 'active' %}bg-green-100 text-green-800
                                                    {% elseif hw.status.value == 'completed' %}bg-blue-100 text-blue-800
                                                    {% elseif hw.status.value == 'abandoned' %}bg-gray-100 text-gray-800
                                                    {% endif %}">
                                                    {{ hw.status.displayName }}
                                                </span>
                                            </div>
                                            
                                            
                                            <div id="status-buttons-{{ hw.id }}" class="mt-2 flex flex-wrap gap-1">
                                                {% if hw.status.value == 'active' %}
                                                    <button onclick="changeStatus({{ hw.id }}, 'completed')"
                                                            class="text-xs bg-blue-100 text-blue-700 hover:bg-blue-200 px-2 py-1 rounded transition-colors">
                                                        → Ukończone
                                                    </button>
                                                    <button onclick="changeStatus({{ hw.id }}, 'abandoned')"
                                                            class="text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 px-2 py-1 rounded transition-colors">
                                                        → Anulowane
                                                    </button>
                                                {% elseif hw.status.value == 'completed' %}
                                                    <button onclick="changeStatus({{ hw.id }}, 'active')"
                                                            class="text-xs bg-green-100 text-green-700 hover:bg-green-200 px-2 py-1 rounded transition-colors">
                                                        → Aktywne
                                                    </button>
                                                    <button onclick="changeStatus({{ hw.id }}, 'abandoned')"
                                                            class="text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 px-2 py-1 rounded transition-colors">
                                                        → Anulowane
                                                    </button>
                                                {% elseif hw.status.value == 'abandoned' %}
                                                    <button onclick="changeStatus({{ hw.id }}, 'active')"
                                                            class="text-xs bg-green-100 text-green-700 hover:bg-green-200 px-2 py-1 rounded transition-colors">
                                                        → Aktywne
                                                    </button>
                                                    <button onclick="changeStatus({{ hw.id }}, 'completed')"
                                                            class="text-xs bg-blue-100 text-blue-700 hover:bg-blue-200 px-2 py-1 rounded transition-colors">
                                                        → Ukończone
                                                    </button>
                                                {% endif %}
                                            </div>
                                            
                                            
                                            <div class="mt-2 flex gap-2">
                                                <button onclick="editHomework({{ hw.id }}, '{{ hw.topic }}', '{{ hw.description }}', '{{ hw.group.id }}', '{{ hw.dueDate|date('Y-m-d') }}')"
                                                        class="text-xs bg-yellow-100 text-yellow-700 hover:bg-yellow-200 px-2 py-1 rounded transition-colors">
                                                    Edytuj
                                                </button>
                                                <button onclick="deleteHomework({{ hw.id }})"
                                                        class="text-xs bg-red-100 text-red-700 hover:bg-red-200 px-2 py-1 rounded transition-colors">
                                                    Usuń
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </main>
        </div>
    </div>

    
    <div id="homeworkModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50 p-4">
        <div id="modalContent"
             class="bg-white rounded-lg shadow-2xl w-1/2 max-w-2xl transform -translate-y-10 opacity-0 transition-all duration-300 ease-out">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-semibold text-gray-900" id="modalTitle">Dodaj Zadanie Domowe</h3>
                    <button onclick="closeHomeworkModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <form id="homeworkForm" method="post" action="{{ path('app_homework_add') }}">
                <div class="px-6 py-4 space-y-4">
                    <div>
                        <label for="topic" class="block text-sm font-medium text-gray-700 mb-1">Temat zadania</label>
                        <input type="text" id="topic" name="topic" required maxlength="255"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Wprowadź temat zadania">
                    </div>

                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Opis (opcjonalnie)</label>
                        <textarea id="description" name="description" rows="3" maxlength="255"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  placeholder="Dodatkowy opis zadania"></textarea>
                    </div>

                    <div>
                        <label for="class" class="block text-sm font-medium text-gray-700 mb-1">Grupa</label>
                        <select id="class" name="class" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Wybierz grupę</option>
                            {% for group in groups %}
                                <option value="{{ group.id }}">{{ group.name.value }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div>
                        <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-1">Termin wykonania</label>
                        <input type="date" id="dueDate" name="dueDate" required
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>

                    <input type="hidden" name="_token" value="{{ csrf_token('homework_add') }}">
                </div>

                <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end space-x-3 rounded-b-lg">
                    <button type="button" onclick="closeHomeworkModal()"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Anuluj
                    </button>
                    <button type="submit"
                            class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Dodaj Zadanie
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let editMode = false;
        let editHomeworkId = null;

        function openHomeworkModal() {
            const modal = document.getElementById('homeworkModal');
            const modalContent = document.getElementById('modalContent');

            modal.classList.remove('hidden');

            setTimeout(() => {
                modalContent.classList.remove('-translate-y-10', 'opacity-0');
                modalContent.classList.add('translate-y-0', 'opacity-100');
            }, 10);

            const today = new Date().toISOString().split('T')[0];
            document.getElementById('dueDate').setAttribute('min', today);
        }

        function editHomework(id, topic, description, classId, dueDate) {
            editMode = true;
            editHomeworkId = id;
            
            document.getElementById('modalTitle').textContent = 'Edytuj Zadanie Domowe';
            document.getElementById('topic').value = topic;
            document.getElementById('description').value = description || '';
            document.getElementById('class').value = classId;
            document.getElementById('dueDate').value = dueDate;
            
            const submitButton = document.querySelector('#homeworkForm button[type="submit"]');
            submitButton.textContent = 'Zapisz Zmiany';
            
            openHomeworkModal();
        }

        function closeHomeworkModal() {
            const modal = document.getElementById('homeworkModal');
            const modalContent = document.getElementById('modalContent');

            modalContent.classList.add('-translate-y-10', 'opacity-0');
            modalContent.classList.remove('translate-y-0', 'opacity-100');

            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('homeworkForm').reset();
                
                editMode = false;
                editHomeworkId = null;
                document.getElementById('modalTitle').textContent = 'Dodaj Zadanie Domowe';
                document.querySelector('#homeworkForm button[type="submit"]').textContent = 'Dodaj Zadanie';
            }, 300);
        }

        function deleteHomework(id) {
            if (confirm('Czy na pewno chcesz usunąć to zadanie domowe?')) {
                fetch(`{{ path('app_homework_delete', {id: '__ID__'}) }}`.replace('__ID__', id), {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Wystąpił błąd podczas usuwania zadania');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Wystąpił błąd podczas usuwania zadania');
                });
            }
        }

        function changeStatus(id, newStatus) {
            fetch(`{{ path('app_homework_status', {id: '__ID__'}) }}`.replace('__ID__', id), {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    status: newStatus
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateStatusBadge(id, data.newStatus, data.newStatusDisplay);
                    updateStatusButtons(id, data.newStatus);
                } else {
                    alert(data.message || 'Wystąpił błąd podczas zmiany statusu');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Wystąpił błąd podczas zmiany statusu');
            });
        }

        function updateStatusBadge(id, status, displayName) {
            const badge = document.getElementById(`status-${id}`);
            badge.textContent = displayName;
            
            badge.classList.remove('bg-green-100', 'text-green-800', 'bg-blue-100', 'text-blue-800', 'bg-gray-100', 'text-gray-800');
            
            if (status === 'active') {
                badge.classList.add('bg-green-100', 'text-green-800');
            } else if (status === 'completed') {
                badge.classList.add('bg-blue-100', 'text-blue-800');
            } else if (status === 'abandoned') {
                badge.classList.add('bg-gray-100', 'text-gray-800');
            }
        }

        function updateStatusButtons(id, currentStatus) {
            const buttonContainer = document.getElementById(`status-buttons-${id}`);
            
            let buttonsHtml = '';
            if (currentStatus === 'active') {
                buttonsHtml = `
                    <button onclick="changeStatus(${id}, 'completed')"
                            class="text-xs bg-blue-100 text-blue-700 hover:bg-blue-200 px-2 py-1 rounded transition-colors">
                        → Ukończone
                    </button>
                    <button onclick="changeStatus(${id}, 'abandoned')"
                            class="text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 px-2 py-1 rounded transition-colors">
                        → Anulowane
                    </button>
                `;
            } else if (currentStatus === 'completed') {
                buttonsHtml = `
                    <button onclick="changeStatus(${id}, 'active')"
                            class="text-xs bg-green-100 text-green-700 hover:bg-green-200 px-2 py-1 rounded transition-colors">
                        → Aktywne
                    </button>
                    <button onclick="changeStatus(${id}, 'abandoned')"
                            class="text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 px-2 py-1 rounded transition-colors">
                        → Anulowane
                    </button>
                `;
            } else if (currentStatus === 'abandoned') {
                buttonsHtml = `
                    <button onclick="changeStatus(${id}, 'active')"
                            class="text-xs bg-green-100 text-green-700 hover:bg-green-200 px-2 py-1 rounded transition-colors">
                        → Aktywne
                    </button>
                    <button onclick="changeStatus(${id}, 'completed')"
                            class="text-xs bg-blue-100 text-blue-700 hover:bg-blue-200 px-2 py-1 rounded transition-colors">
                        → Ukończone
                    </button>
                `;
            }
            
            buttonContainer.innerHTML = buttonsHtml;
        }

        document.getElementById('homeworkModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeHomeworkModal();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('homeworkModal');
                if (!modal.classList.contains('hidden')) {
                    closeHomeworkModal();
                }
            }
        });

        document.getElementById('homeworkForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            let url = this.action;
            
            if (editMode && editHomeworkId) {
                url = `{{ path('app_homework_edit', {id: '__ID__'}) }}`.replace('__ID__', editHomeworkId);
            }
            
            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeHomeworkModal();
                    location.reload();
                } else {
                    alert(data.message || `Wystąpił błąd podczas ${editMode ? 'edycji' : 'dodawania'} zadania`);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(`Wystąpił błąd podczas ${editMode ? 'edycji' : 'dodawania'} zadania`);
            });
        });
    </script>
{% endblock %}
