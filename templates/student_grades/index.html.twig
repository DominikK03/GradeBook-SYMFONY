{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex h-screen overflow-hidden">
        {% include 'utils/_navbar.html.twig' %}

        <div class="flex flex-col flex-1 overflow-hidden md:pl-64">
            {% include 'utils/_topheader.html.twig' %}

            <main class="flex-1 overflow-y-auto p-6"
                  style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                <div class="bg-white rounded-lg shadow p-6 overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Przedmiot
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Kartkówka
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Sprawdzian
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Praca Domowa
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Projekt
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Średnia
                            </th>
                        </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for subject in subjects %}
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                        {{ subject|trans({}, 'subjects') }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if grades[subject]['QUIZ'] is defined %}
                                            {% for grade in grades[subject]['QUIZ'] %}
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-1 cursor-pointer relative"
                                                      onmouseenter="showTooltip(this)"
                                                      onmouseleave="hideTooltip(this)"
                                                      data-tooltip="Ocena: {{ grade.value }}|Data: {{ grade.date|date('d.m.Y') }}|Waga: {{ grade.wage }}|Nauczyciel: {{ grade.teacher.person.lastName }} {{ grade.teacher.person.firstName }}|Opis: {% if grade.description is empty %}Brak{% else %}{{ grade.description }}{% endif %}">
                                                    {{ grade.value }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if grades[subject]['EXAM'] is defined %}
                                            {% for grade in grades[subject]['EXAM'] %}
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 mr-1 cursor-pointer relative"
                                                      onmouseenter="showTooltip(this)"
                                                      onmouseleave="hideTooltip(this)"
                                                      data-tooltip="Ocena: {{ grade.value }}|Data: {{ grade.date|date('d.m.Y') }}|Waga: {{ grade.wage }}|Nauczyciel: {{ grade.teacher.person.lastName }} {{ grade.teacher.person.firstName }}|Opis: {% if grade.description is empty %}Brak{% else %}{{ grade.description }}{% endif %}">
                                                    {{ grade.value }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if grades[subject]['HOMEWORK'] is defined %}
                                            {% for grade in grades[subject]['HOMEWORK'] %}
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 mr-1 cursor-pointer relative"
                                                      onmouseenter="showTooltip(this)"
                                                      onmouseleave="hideTooltip(this)"
                                                      data-tooltip="Ocena: {{ grade.value }}|Data: {{ grade.date|date('d.m.Y') }}|Waga: {{ grade.wage }}|Nauczyciel: {{ grade.teacher.person.lastName }} {{ grade.teacher.person.firstName }}|Opis: {% if grade.description is empty %}Brak{% else %}{{ grade.description }}{% endif %}">
                                                    {{ grade.value }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if grades[subject]['PROJECT'] is defined %}
                                            {% for grade in grades[subject]['PROJECT'] %}
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 mr-1 cursor-pointer relative"
                                                      onmouseenter="showTooltip(this)"
                                                      onmouseleave="hideTooltip(this)"
                                                      data-tooltip="Ocena: {{ grade.value }}|Data: {{ grade.date|date('d.m.Y') }}|Waga: {{ grade.wage }}|Nauczyciel: {{ grade.teacher.person.lastName }} {{ grade.teacher.person.firstName }}|Opis: {% if grade.description is empty %}Brak{% else %}{{ grade.description }}{% endif %}">
                                                    {{ grade.value }}
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if grades[subject]['weightedAverage'] is defined %}
                                            {{ "%.2f"|format(grades[subject]['weightedAverage']) }}
                                        {% else %}
                                            Brak ocen
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </main>
        </div>
    </div>

    <script>
        function showTooltip(element) {
            const tooltipData = element.getAttribute('data-tooltip').split('|');
            const tooltip = document.createElement('div');
            tooltip.className = 'absolute bg-white border-4 border-gray-800 shadow-lg text-gray-800 text-sm rounded-lg py-3 px-4 bottom-full left-1/2 transform -translate-x-1/2 mb-2 min-w-max z-50';
            tooltip.innerHTML = tooltipData.map(line => `<div class="mb-1 last:mb-0">${line}</div>`).join('');

            const arrow = document.createElement('div');
            arrow.className = 'absolute top-full left-1/2 transform -translate-x-1/2 border-8 border-transparent border-t-gray-800';
            tooltip.appendChild(arrow);

            element.appendChild(tooltip);
        }

        function hideTooltip(element) {
            const tooltip = element.querySelector('div');
            if (tooltip) tooltip.remove();
        }
    </script>
{% endblock %}
