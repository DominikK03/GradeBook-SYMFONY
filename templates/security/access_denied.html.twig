{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex h-screen overflow-hidden">
        {% if app.user %}
            {% include 'utils/_navbar.html.twig' %}
        {% endif %}

        <div class="flex flex-col flex-1 overflow-hidden {% if app.user %}md:pl-64{% endif %}">
            {% if app.user %}
                {% include 'utils/_topheader.html.twig' with {'TopNavbarTitle': title} %}
            {% endif %}

            <main class="flex-1 overflow-y-auto p-4 sm:p-6"
                  style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                
                <div class="flex items-center justify-center min-h-full">
                    <div class="text-center">
                        <h2 class="text-xl font-bold text-gray-700 mb-8">{{ title }}</h2>
                        
                        <div class="mx-auto mb-8">
                            <svg class="text-red-500 mx-auto" style="width: 128px; height: 128px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                      d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"/>
                            </svg>
                        </div>
                        
                        <p class="text-gray-600 mb-8">{{ message }}</p>
                        
                        <div class="flex justify-center space-x-6">
                            <a href="{{ path('homepage') }}" 
                               class="px-6 py-3 bg-blue-500 text-white border-2 border-blue-500 rounded-lg hover:bg-blue-600 hover:border-blue-600 transition-colors font-medium">
                                Strona główna
                            </a>
                            
                            {% if app.user %}
                                <a href="{{ path('app_logout') }}" 
                                   class="px-6 py-3 bg-gray-500 text-white border-2 border-gray-500 rounded-lg hover:bg-gray-600 hover:border-gray-600 transition-colors font-medium">
                                    Wyloguj się
                                </a>
                            {% else %}
                                <a href="{{ path('app_login') }}" 
                                   class="px-6 py-3 bg-gray-500 text-white border-2 border-gray-500 rounded-lg hover:bg-gray-600 hover:border-gray-600 transition-colors font-medium">
                                    Zaloguj się
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
{% endblock %}
