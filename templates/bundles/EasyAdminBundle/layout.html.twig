{% extends '@!EasyAdmin/layout.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Ukryj niechciane elementy EasyAdmin */
        .navbar .navbar-nav.ms-auto,
        .header-nav-item,
        .color-scheme-toggle,
        .user-menu,
        .responsive-header-btn {
            display: none !important;
        }

        /* Dodaj własny sidebar */
        .ea-sidebar {
            width: 250px !important;
        }
    </style>
{% endblock %}

{% block header_navbar %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('admin') }}">
                <i class="fas fa-graduation-cap me-2"></i>
                System Zarządzania Szkołą
            </a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('homepage') }}">
                    <i class="fas fa-home"></i> Strona główna
                </a>
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Wyloguj
                </a>
            </div>
        </div>
    </nav>
{% endblock %}

{% block sidebar %}
    <div class="bg-white border-end ea-sidebar" style="width: 250px; min-height: calc(100vh - 56px);">
        <div class="p-3">
            <h5 class="text-muted">Menu</h5>

            <div class="list-group list-group-flush">
                <a href="{{ path('admin') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                </a>

                <div class="mt-3 mb-2 text-muted"><small><strong>UŻYTKOWNICY</strong></small></div>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-users me-2"></i> Użytkownicy
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\PersonCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-user me-2"></i> Osoby
                </a>

                <div class="mt-3 mb-2 text-muted"><small><strong>SZKOŁA</strong></small></div>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\StudentCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-graduation-cap me-2"></i> Uczniowie
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\TeacherCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-chalkboard-teacher me-2"></i> Nauczyciele
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\GroupCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-users me-2"></i> Grupy/Klasy
                </a>

                <div class="mt-3 mb-2 text-muted"><small><strong>EDUKACJA</strong></small></div>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\GradeCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-star me-2"></i> Oceny
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\HomeworkCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-book me-2"></i> Zadania domowe
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\ScheduleCrudController') }}" class="list-group-item list-group-item-action">
                    <i class="fas fa-calendar-alt me-2"></i> Plan zajęć
                </a>
            </div>
        </div>
    </div>
{% endblock %}